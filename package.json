{
  "name": "latex-delimiter-renderer",
  "version": "1.0.2",
  "private": true,
  "description": "Render LaTeX paren and bracket math delimiters in Obsidian without modifying note source.",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "check:versions": "node scripts/check-versions.mjs",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:versions && npm run lint && npm test && npm run typecheck && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BurgerAndreas/latex-delimiter-renderer.git"
  },
  "bugs": {
    "url": "https://github.com/BurgerAndreas/latex-delimiter-renderer/issues"
  },
  "homepage": "https://github.com/BurgerAndreas/latex-delimiter-renderer#readme",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.1.0",
    "esbuild": "^0.25.8",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "obsidian": "^1.13.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0"
  }
}
